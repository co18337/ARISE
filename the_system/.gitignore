# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ---------------------------------------------------------------------------
# Secrets. The Gemini API key lives here and is NEVER committed.
# `.env.example` is committed so the file's shape is known; `.env` is not.
# ---------------------------------------------------------------------------
assets/config/.env

# ---------------------------------------------------------------------------
# Exercise demonstration GIFs. Fetched locally by tool/fetch_exercise_gifs.sh,
# never committed: the artwork is not mine to redistribute. Personal, local,
# non-commercial use only. Run the script to get them on a new machine.
# ---------------------------------------------------------------------------
assets/exercises/*.gif

# Summoning animation — anime footage, personal local use only, same rule as
# the exercise demonstrations. Never committed, never redistributed.
assets/solo-leveling-*.gif

# Launcher icon source artwork — personal, kept local like the other media.
# The GENERATED mipmaps under android/app/src/main/res ARE committed; they are
# what the build needs and they are small.
assets/icon/source_crest.png
assets/icon/crest.png

assets/icons/cropped_badges/
