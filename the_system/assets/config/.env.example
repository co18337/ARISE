# Copy this file to `.env` in the same folder and fill in the value.
#
# assets/config/.env is gitignored and never committed. This example IS
# committed, so the shape of the file is known without the secret being in it.
#
# Get a key: https://aistudio.google.com/apikey  (Gemini free tier)
GEMINI_API_KEY=

# Optional overrides. Leave blank for the defaults in lib/config/app_config.dart.
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=

# ---------------------------------------------------------------------------
# Groq — https://console.groq.com  (API Keys; free tier, no card)
#
# The router tries Groq FIRST because it is markedly faster — sub-second where
# Gemini takes two to eight — then falls to Gemini when Groq is busy, out of
# daily tokens, or absent. Either key alone works. Neither key also works: the
# app logs food and issues sessions without any model at all.
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# Optional. Blank uses the default in lib/config/app_config.dart.
GROQ_MODEL=
